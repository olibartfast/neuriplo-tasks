{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/inject_ci_context.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format_on_edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block_large_binaries.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(clang-format-18:*)",
      "Bash(clang-tidy-18:*)",
      "Bash(cppcheck:*)",
      "Bash(find src include tests:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit install)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf .github:*)",
      "Bash(rm -rf .claude:*)",
      "Bash(rm -rf 3rdparty:*)"
    ]
  }
}
